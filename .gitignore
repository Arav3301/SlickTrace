# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — also covers .opencode/node_modules)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime artifacts / local QA
*.log
*shot.png
qa-*.png
scripts/qa-*.mjs
scripts/verify-*.mjs

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw imaging + archives not needed at runtime
# (lightweight previews and derived data live in public/data/detection)
*.tif
*.tiff
*.rar
demo-data/SlickTrace_Demo_Bundle.zip